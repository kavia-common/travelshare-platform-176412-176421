# TripTales – Environment Variables Example
# Copy this file to ".env" and fill in the values.
# Never commit your real secrets.

# MongoDB connection string (required)
# Example (MongoDB Atlas):
# mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/dbname?retryWrites=true&w=majority

# Cloudinary (required for signed uploads)
# Your Cloudinary cloud name (e.g., "my-cloud")
CLOUDINARY_CLOUD_NAME=your_cloud_name
# Cloudinary API Key (from dashboard)
CLOUDINARY_API_KEY=your_api_key
# Cloudinary API Secret (keep private; never expose to client)
CLOUDINARY_API_SECRET=your_api_secret

# Optional: If you use an unsigned upload preset, set it here.
# For signed uploads flow, this can be omitted.
CLOUDINARY_UPLOAD_PRESET=optional_unsigned_preset

# Public config for client bundles
# This helps with client-side usage and absolute URLs generation
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Optional: Used to build absolute URLs in SSR/metadata (preferred in production)
# Example: https://triptales.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
