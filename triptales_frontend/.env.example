# TripTales Frontend - Example Environment Variables
# Copy this file to .env and fill in values for your environment.

# MongoDB
MONGODB_URI=mongodb://localhost:27017/triptales

# Cloudinary (required for uploads signing)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional unsigned preset or to include in signed params
CLOUDINARY_UPLOAD_PRESET=optional_preset_name

# Client-exposed values
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=${CLOUDINARY_CLOUD_NAME}
# Absolute site URL for SEO and SSR fetches (set in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
