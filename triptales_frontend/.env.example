# MongoDB
MONGODB_URI=mongodb://localhost:27017/triptales

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional (unsigned preset)
CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# Public Cloudinary name for client
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Site URL (recommended in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authentication
# Must be a sufficiently long random string (>=16 chars). Example below is placeholder - replace it.
AUTH_SECRET=please-change-this-to-a-long-random-secret
