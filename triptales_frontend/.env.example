# TripTales example environment variables

# MongoDB
MONGODB_URI=mongodb+srv://USER:PASS@cluster.example.mongodb.net/triptales

# Cloudinary (server-side)
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=abc123yoursecret

# Optional upload preset
CLOUDINARY_UPLOAD_PRESET=unsigned-or-named-preset

# Client-exposed Cloudinary name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud

# Authentication secret for signing session cookies (min length 16)
AUTH_SECRET=please-change-me-to-a-long-random-string

# Recommended: absolute URL for server-side absolute fetches/SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3000
