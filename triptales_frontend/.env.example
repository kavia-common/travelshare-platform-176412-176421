# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/triptales

# Cloudinary - required for direct image uploads
# Required server-side vars (do NOT expose secrets in client):
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional:
# If you use an unsigned preset, you can include it here. If you use a signed preset, it will be included in the signature.
CLOUDINARY_UPLOAD_PRESET=your_optional_preset

# Publicly readable client var for convenience (falls back to CLOUDINARY_CLOUD_NAME if omitted)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
